# Copy this file to .env and fill in what you need. Everything is optional:
# with no .env at all, TipidLitro runs on SQLite with free, keyless APIs.

# ---------- Server ----------
PORT=3000
# Set to true when serving over HTTPS (secure cookies)
COOKIE_SECURE=false

# ---------- Database ----------
# sqlite (default, zero setup) or mysql (MySQL / MariaDB, e.g. XAMPP)
DB_CLIENT=sqlite
SQLITE_PATH=./data/tipidlitro.db

# Used only when DB_CLIENT=mysql. The database is created automatically.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tipidlitro

# ---------- AI assistant (optional) ----------
# Free key: https://aistudio.google.com/apikey  — without it the assistant uses a rule-based parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Oil market (optional) ----------
# Without keys, Brent comes from FRED's public CSV. Keys give official API access.
# EIA: https://www.eia.gov/opendata/register.php   FRED: https://fred.stlouisfed.org/docs/api/api_key.html
EIA_API_KEY=
FRED_API_KEY=

# ---------- Extra news sources (optional) ----------
# GNews: https://gnews.io   NewsData.io: https://newsdata.io
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# ---------- Polite API use ----------
# Nominatim asks apps to identify themselves; your email is added to the User-Agent if set.
CONTACT_EMAIL=

# ---------- Sync ----------
ENABLE_SCHEDULER=true
# How many recent weeks of NCR reports / adjustment notices the hourly check keeps in view.
# Older history (back to 2017) is imported on demand: Integration Monitor or `npm run backfill -- all`.
DOE_BACKFILL_WEEKS=26

# ---------- Electric vehicles ----------
# Pesos per kWh used for EV trips (no free official real-time API; roughly Meralco's residential rate).
# Users can override it per trip in Trip options.
ELECTRICITY_RATE=12.50
# This email becomes admin when it registers (the first account is always admin)
ADMIN_EMAIL=

# ---------- Routing (advanced) ----------
OSRM_URL=https://router.project-osrm.org
OSRM_FALLBACK_URL=https://routing.openstreetmap.de/routed-car
